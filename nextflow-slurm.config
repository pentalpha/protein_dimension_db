workDir = "/scratch/global/pdaasobrinho/work"
conda.enabled = true
params.max_taxons = 256
params.esm_processes = 30
params.esm_models_to_use = [6, 12, 30, 33]
params.parsing_processes = 8

executor {
    queueSize = 4
}

process {
    executor = 'slurm'
    queue = 'intel-128'
    memory = '24 GB'
    time = '30 min'
    cpus = 4

    withLabel: 'long' {
        cpus = 8
        memory = '40 GB'
        time = '12 h'
        queue = 'gpu-8-h100'
    }
    withName:download_esm {
        container = 'singularity/sif/env2.sif'
    }
    withName:taxa_profiles_train {
        container = 'singularity/sif/env2.sif'
    }
    withName:taxa_profiles {
        container = 'singularity/sif/basic_env.sif'
    }
    withName:taxa_profiles_test {
        container = 'singularity/sif/basic_env.sif'
    }
    withName:index_go_by_term {
        container = 'singularity/sif/env2.sif'
    }
    withName:list_annotated_trembl {
        container = 'singularity/sif/env2.sif'
    }
    withName:process_goa {
        container = 'singularity/sif/env2.sif'
    }
    withName:prottrans_embs {
        container = 'singularity/sif/env2.sif'
    }
    withName:calc_ankh_embeddings {
        container = 'singularity/sif/ankh.sif'
    }
    withName:calc_esm_embeddings {
        container = 'singularity/sif/ankh.sif'
    }
}

singularity {
    enabled = true
    autoMounts = true
    runOptions = "--bind /home/pdaasobrinho/.cache:/home/pdaasobrinho/.cache --nv"
}