//conda.enabled = true
//conda.useMamba = true
params.max_taxons = 256
params.esm_processes = 30
params.esm_models_to_use = [6, 12, 30, 33]
params.parsing_processes = 12
params.raw_data_dir = params.release_dir + "/raw_data"
params.interpro_data_dir = "/data/home/pitagoras/data/interproscan/interpro_data"
params.interproscan_tmp_dir = "/data3/pitagoras/data/interproscan"
workDir = "/data3/pitagoras/data/pddb_work"
params.interproscan_cpus = 5

executor {
    queueSize = 2
}

process {
    container = 'singularity/sif/basic_env.sif'

    withName: taxa_profiles {
        container = 'singularity/sif/basic_env.sif'
    }

    withName: run_interproscan_pipeline {
        // Disable the container for this specific wrapper task
        container = null
        // Run on the local machine/head node where Nextflow is installed
        executor = 'local'
    }

    withName: make_interpro_obo {
        container = 'singularity/sif/obonet_scipy.sif'
    }
    withName: calc_interpro_ia {
        container = 'singularity/sif/obonet_scipy.sif'
    }
    withName: calc_taxid_ia {
        container = 'singularity/sif/obonet_scipy.sif'
    }

    withName: index_go_by_term {
        container = 'singularity/sif/env2.sif'
    }
    withName: list_annotated_trembl {
        container = 'singularity/sif/env2.sif'
    }
    withName: process_goa {
        container = 'singularity/sif/env2.sif'
    }
    withName: parse_goa {
        container = 'singularity/sif/env2.sif'
    }
    withName: prottrans_embs {
        container = 'singularity/sif/env2.sif'
    }
    withName: parse_interpro_raw {
        container = 'singularity/sif/env2.sif'
    }
    withName: make_taxallnomy_parquet {
        container = 'singularity/sif/env2.sif'
    }
    withName: make_taxid_obo {
        container = 'singularity/sif/env2.sif'
    }
    withName: make_go_parquets {
        container = 'singularity/sif/env2.sif'
    }
    withName: parse_deeploc {
        container = 'singularity/sif/env2.sif'
    }

    withName: list_taxids {
        container = 'singularity/sif/python_legacy.sif'
    }

    //the autoencoder needs a torch installation
    withName: train_interpro_autoencoder_256 {
        container = 'singularity/sif/ankh.sif'
    }
    withName: train_interpro_autoencoder_512 {
        container = 'singularity/sif/ankh.sif'
    }
    withName: train_interpro_autoencoder_640 {
        container = 'singularity/sif/ankh.sif'
    }
    withName: train_interpro_autoencoder_896 {
        container = 'singularity/sif/ankh.sif'
    }
    withName: train_interpro_autoencoder_1280 {
        container = 'singularity/sif/ankh.sif'
    }

    withName: calc_ankh {
        container = 'singularity/sif/ankh.sif'
    }
    withName: calc_esm_embeddings {
        container = 'singularity/sif/ankh.sif'
    }
}

singularity {
    enabled = true
    runOptions = "--nv --bind /data/home/pitagoras/serido/.cache:/data/home/pitagoras/serido/.cache,/data/home/pitagoras/.cache:/data/home/pitagoras/.cache"
}
