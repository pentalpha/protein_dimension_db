Bootstrap: docker
From: pytorch/pytorch:2.4.1-cuda12.4-cudnn9-devel

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install dev packages to make sure that cmake will be available and any pip package can be build
    apt update && apt install -y build-essential libssl-dev libffi-dev python3-dev cmake build-essential pkg-config libgoogle-perftools-dev ffmpeg
    
    # Update pip
    pip install --upgrade pip
    
    # Install cmake python package to fix potential python-wrapped cmake issues
    pip install cmake pandas polars numpy tqdm polars imageio[ffmpeg] seaborn regex pyarrow openpyxl obonet networkx \
        transformers einops scikit-learn